# ==============================================================================
# .gitignore — Omnimorph Pitch & Storytelling
# ==============================================================================

# Sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporales, scratch y pruebas efímeras (clean-workspace-archive)
/tmp/
scratch/
tmp/
*.tmp
*.log

# Entornos y credenciales
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json
token.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Binarios y datos pesados (prohibidos en git)
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle
*.weights
*.pt
*.pth
*.onnx

# Archivos de video y medios pesados (por derechos y tamaño)
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv
*.raw
*.tar
*.tar.gz
*.zip
*.rar
*.7z

# Node / JS
node_modules/
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
.cache/

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~
